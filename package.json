{
  "name": "wordlit",
  "productName": "Wordlit",
  "version": "0.1.0",
  "description": "Word-by-word synced lyrics for Windows, on a lock-style screen or an always-on overlay.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "Wordlit",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-fluent-icons.mjs && electron scripts/make-icons.mjs",
    "snapshot": "electron-vite build && electron . --snapshot=snapshots",
    "package": "npm run build && node scripts/package-win.mjs",
    "fake-player": "electron scripts/fake-player/main.cjs",
    "check:lrclib": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@iconify-json/fluent": "1.2.58",
    "@types/node": "^24.9.0",
    "electron": "44.4.4",
    "electron-vite": "5.0.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
